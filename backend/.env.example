# Boş bırakılırsa yerelde SQLite kullanılır. Render bu değeri kendisi verir.
DATABASE_URL=sqlite:///./agilematch.db
# En az 32 karakter. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Virgülle ayrılmış frontend adresleri (ör. Vercel adresi)
CORS_ORIGINS=http://localhost:3000
# İlk yönetici hesabı. ADMIN_PASSWORD boşsa seed betiği rastgele şifre üretip ekrana yazar.
ADMIN_EMAIL=ik@sirket.com
ADMIN_PASSWORD=
